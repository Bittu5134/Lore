#!/usr/bin/env node
/**
 * Cross-platform `lore` launcher.
 *
 * Prefers the repo-local tsx binary (works offline, no npx fetch) and falls
 * back to `npx --yes tsx` when the repo has not been `npm install`ed yet.
 */
import { spawnSync } from "node:child_process";
import { dirname, join } from "node:path";
import { existsSync, realpathSync } from "node:fs";
import { fileURLToPath } from "node:url";

const here = dirname(realpathSync(fileURLToPath(import.meta.url)));
const entry = join(here, "..", "src", "index.ts");
const args = process.argv.slice(2);
const binDir = join(here, "..", "..", "..", "node_modules", ".bin");
const isWin = process.platform === "win32";

function run(cmd, cmdArgs) {
  return spawnSync(cmd, cmdArgs, { stdio: "inherit", shell: isWin });
}

const localTsx = [join(binDir, "tsx"), join(binDir, "tsx.cmd")].find((p) => existsSync(p));

let result;
if (localTsx && localTsx.endsWith(".cmd")) {
  result = run(localTsx, [entry, ...args]);
} else if (localTsx) {
  // npm's .bin/tsx is a node script with a shebang - run it with this node.
  result = run(process.execPath, [localTsx, entry, ...args]);
} else {
  result = run("npx", ["--yes", "tsx", entry, ...args]);
}

process.exit(typeof result.status === "number" ? result.status : 1);
