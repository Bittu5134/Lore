{
  "name": "lore",
  "private": true,
  "version": "0.0.1",
  "description": "Lore - a local architectural knowledge engine that preserves the why behind software decisions",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lore": "tsx packages/cli/src/index.ts",
    "build": "tsc -b packages/core packages/cli packages/mcp packages/plugin",
    "test": "tsx --test packages/core/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.23.8"
  }
}
